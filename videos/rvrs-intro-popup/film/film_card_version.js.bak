// RVRS app intro, 5 s, 9:16. One scene: dot -> popup card -> logo reveal -> ring pulse -> card covers screen -> lock-up.
// Pure function of time. Everything keyed to marks in timeline.json (dot, card, logo, pulse, cover, end, done).
(() => {
  const { W, H, put, reg, el, scene, sp, spHit, seg, clamp, lerp, ease, bt, beatOf } = C;
  C.fonts = [];
  const CX = W / 2, CY = 860;                  // popup centre, a little above middle (clear of bottom 20% zone)
  const LW = 1100, LH = Math.round(1100 * 1250 / 1700);   // padded logo image box (glow margin included)
  const CARD_W = 930, CARD_H = 820;

  function drawLogo(S, prog, fin) {
    const m = S.mask.getContext('2d'), g = S.logo.getContext('2d');
    m.clearRect(0, 0, 1700, 1250); m.strokeStyle = '#fff'; m.lineWidth = 72; m.lineCap = 'round'; m.lineJoin = 'round';
    let left = prog * S.tot;
    m.beginPath();
    for (let i = 0; i < LOGO_PATHS.length && left > 0; i++) {
      const p = LOGO_PATHS[i], c = S.seg[i], len = c[c.length - 1];
      m.moveTo(p[0][0], p[0][1]);
      for (let j = 1; j < p.length; j++) {
        if (left >= c[j]) { m.lineTo(p[j][0], p[j][1]); continue; }
        const f = (left - c[j - 1]) / (c[j] - c[j - 1]);
        m.lineTo(p[j - 1][0] + (p[j][0] - p[j - 1][0]) * f, p[j - 1][1] + (p[j][1] - p[j - 1][1]) * f);
        break;
      }
      left -= len;
    }
    m.stroke();
    g.globalCompositeOperation = 'source-over'; g.globalAlpha = 1; g.clearRect(0, 0, 1700, 1250);
    g.drawImage(S.src, 0, 0, 1700, 1250);
    g.globalCompositeOperation = 'destination-in'; g.drawImage(S.mask, 0, 0);
    if (fin > 0.001) { g.globalCompositeOperation = 'source-over'; g.globalAlpha = fin; g.drawImage(S.src, 0, 0, 1700, 1250); g.globalAlpha = 1; }
  }

  scene({
    name: 'intro', from: 'dot', to: 'done',
    build(root, S) {
      root.style.background = 'var(--bg)';
      S.cam = el('div', { class: 'abs', style: `width:${W}px;height:${H}px;transform-origin:50% 50%` }, root); reg(S.cam);
      S.ring1 = el('div', { class: 'abs', style: 'border-radius:50%;box-sizing:border-box;border:30px solid #fff' }, S.cam); reg(S.ring1, { o: 0 });
      S.card = el('div', { class: 'card', style: 'left:0;top:0;width:10px;height:10px' }, S.cam); reg(S.card, { o: 0 });
      S.shadow = el('div', { class: 'abs', style: 'width:620px;height:70px;border-radius:50%;background:rgba(241,90,36,.22);filter:blur(26px)' }, S.cam); reg(S.shadow, { o: 0 });
      S.src = el('img', { src: '../assets/brand/logo_pad.png', style: 'position:absolute;width:1px;height:1px;opacity:0;pointer-events:none' }, root);   // preloaded by READY, drawn into the canvases below
      S.logo = el('canvas', { class: 'abs', width: 1700, height: 1250, style: `width:${LW}px;height:${LH}px;transform-origin:50% 50%` }, S.cam); reg(S.logo, { o: 0 });
      S.mask = document.createElement('canvas'); S.mask.width = 1700; S.mask.height = 1250;
      S.seg = LOGO_PATHS.map((p) => { const c = [0]; for (let i = 1; i < p.length; i++) c.push(c[i - 1] + Math.hypot(p[i][0] - p[i - 1][0], p[i][1] - p[i - 1][1])); return c; });
      S.tot = S.seg.reduce((a, c) => a + c[c.length - 1], 0);
      S.ring2 = el('div', { class: 'abs', style: 'border-radius:50%;box-sizing:border-box;border:24px solid var(--accent)' }, S.cam); reg(S.ring2, { o: 0 });
    },
    run(t, b, S) {
      // slow camera push over the whole film: nothing is ever static
      put(S.cam, { s: 1 + 0.04 * ease.inOut(seg(t, 0, 'done')) + 0.08 * ease.inOut(seg(t, 'cover', 'done')) });

      // 1) dot pops on frame 0 (released before t=0 so frame 0 already reads), 2) grows into the card on b1, 3) card covers on b5
      const dot = C.trk(t, [[-0.3, 0.55], [-0.1, 1.3, 'snappy'], [0.45, 1, 'snappy']]) , grow = C.trk(t, [[0, 0], [beatOf('card') - 0.12, 1.05, 'default'], [beatOf('card') + 0.7, 1, 'snappy']]);
      const cover = spHit(t, 'cover', 'default');
      const nudge = spHit(t, 3, 'snappy') * (1 - spHit(t, 4, 'snappy')) , tail = spHit(t, 7, 'snappy');
      const lift = spHit(t, 'pulse', 'snappy');                          // card rises 6% on the bar-2 downbeat
      let w = lerp(170 * dot, CARD_W, grow), h = lerp(170 * dot, CARD_H, grow);
      const rad = lerp(85, 60, grow);
      w = lerp(w, W + 120, cover); h = lerp(h, H + 120, cover);
      const cy = lerp(CY, H / 2, cover), s = (1 + 0.06 * lift * (1 - cover)) * (1 + 0.03 * seg(t, 'logo', 'pulse')) * (1 + 0.04 * nudge);
      put(S.card, { o: 1, x: CX - w / 2, y: cy - h / 2, s, css: { width: w + 'px', height: h + 'px', borderRadius: lerp(rad, 0, cover) + 'px', transformOrigin: '50% 50%' } });

      // logo: cord art draws on left->right (mask sweep) while it scales in, on b2
      const lp = spHit(t, 'logo', 'heavy');
      // the cord draws itself: traced centre-lines (LOGO_PATHS) are stroked progressively into a mask that reveals the real logo texture
      const prog = Math.pow(seg(t, 1.0, 3.4), 0.92), fin = ease.inOut(clamp((prog - 0.86) / 0.14));
      drawLogo(S, prog, fin);
      const reveal = prog;
      const flash = 1 + 0.4 * Math.exp(-Math.max(0, t - bt('pulse')) * 7) * (t >= bt('pulse') ? 1 : 0);
      const kick = spHit(t, 'end', 'snappy') * (1 - Math.min(1, seg(t, 'end', beatOf('end') + 0.9)));
      const ly = lerp(CY, 890, cover), ls = (0.8 + 0.2 * lp) * (1 + 0.06 * lift * (1 - cover)) * lerp(1, 0.86, cover) * (1 + 0.05 * ease.inOut(seg(t, 'logo', 'pulse'))) * (1 + 0.08 * kick) * (1 + 0.05 * tail) * (1 + 0.025 * nudge);
      put(S.logo, { o: reveal > 0.001 ? 1 : 0, x: CX - LW / 2 - 24, y: ly - LH / 2, s: ls,
        filter: `brightness(${flash.toFixed(3)}) saturate(${(1 + (flash - 1) * 0.8).toFixed(3)})` });

      put(S.shadow, { o: cover > 0.02 ? Math.min(1, cover) : 0, x: CX - 310, y: ly + 300, s: 1 + 0.05 * kick });
      // rings: white on orange at the downbeat (b4), orange on white at the final hit (b6); both travel past the frame edge
      const ring = (e, beat, cyR, start) => {
        const k = Math.pow(ease.out(seg(t + 0.06, beat, beatOf(beat) + 1.4)), 1.8), d = lerp(start, 2900, k);
        put(e, { o: t + 0.06 >= bt(beat) ? 1 : 0, x: CX - d / 2, y: cyR - d / 2, css: { width: d + 'px', height: d + 'px' } });
      };
      ring(S.ring1, 'pulse', CY, 400);
      ring(S.ring2, 'end', 890, 60);
    },
  });
  C.start();
})();
